DATABASE_URL=postgresql+asyncpg://game:game@localhost:5435/interview_game
POSTGRES_DB=interview_game
POSTGRES_USER=game
POSTGRES_PASSWORD=game
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
QWEN_URL=http://localhost:8081/v1/chat/completions
QWEN_MODEL=Qwen3-0.6B
WHISPER_URL=http://localhost:8082/inference
AI_TIMEOUT_SECONDS=120
MAX_AUDIO_BYTES=10485760

# Permit WebSocket clients from private LAN IPs when serving Vite to friends.
ALLOW_LAN_WEBSOCKET_ORIGINS=true
